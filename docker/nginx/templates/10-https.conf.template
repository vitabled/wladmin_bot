# :443 — single domain, path-based routing (WHICH path goes WHERE).
# Proxy targets (upstreams) and shared headers live in ../nginx.conf.
#   /webhook (+ /health) → bot_backend      (Telegram webhook)
#   everything else       → dashboard_backend (web panel)
# Certs come from the certbot volume; a self-signed placeholder is seeded by
# nginx-init so nginx can start before a real cert is issued.
#
# NOTE: if you change WEBHOOK_PATH (default /webhook), update the location below.
server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/nginx/certs/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/live/${DOMAIN}/privkey.pem;

    client_max_body_size 1m;

    # --- bot webhook -----------------------------------------------------
    location = /webhook {
        proxy_pass http://bot_backend;
    }

    location = /health {
        proxy_pass http://bot_backend;
    }

    # --- web dashboard (catch-all) ---------------------------------------
    location / {
        proxy_pass http://dashboard_backend;
        proxy_http_version 1.1;
    }
}
