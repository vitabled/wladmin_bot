# :80 — Let's Encrypt HTTP-01 challenge + redirect everything else to HTTPS.
# Rendered by the nginx image's envsubst (only ${DOMAIN} is substituted).
server {
    listen 80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
