# Rendered by the nginx image's envsubst at startup: only ${WEBHOOK_DOMAIN} and
# ${DASHBOARD_DOMAIN} are substituted; nginx runtime vars ($host, $scheme, …)
# are left untouched because they are not environment variables.

# --- HTTP :80 — ACME challenge + redirect everything to HTTPS ---------------
server {
    listen 80 default_server;
    server_name _;

    # Let's Encrypt HTTP-01 challenge (shared with a future certbot service).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- HTTPS :443 — proxy #1: bot webhook -------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name ${WEBHOOK_DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # Telegram webhook payloads are small; cap the body to be safe.
    client_max_body_size 1m;

    location / {
        proxy_pass http://bot:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# --- HTTPS :443 — proxy #2: web dashboard (default vhost) -------------------
server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${DASHBOARD_DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    location / {
        proxy_pass http://dashboard:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
