# --- Telegram / webhook ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Public HTTPS URL Telegram will POST updates to (path must match WEBHOOK_PATH).
WEBHOOK_URL=https://your-domain.com/webhook
# Random secret; verified against the X-Telegram-Bot-Api-Secret-Token header.
WEBHOOK_SECRET=change-me-to-a-long-random-string
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
WEBHOOK_PATH=/webhook

# Your Telegram numeric user id (bot owner; bypasses admin checks).
OWNER_ID=123456789

# --- Database (compose builds DATABASE_URL from these) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=telegram_bot
# For local (non-docker) runs, set the full async URL:
# DATABASE_URL=postgresql+asyncpg://admin:password@localhost:5432/telegram_bot

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Logging ---
LOG_LEVEL=info
LOG_FILE=logs/app.log

# --- i18n / cache ---
DEFAULT_LANGUAGE=ru
SETTINGS_CACHE_TTL=3600

# --- Web dashboard (Phase 7) ---
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Bot @username (no @) for the Telegram Login widget on the dashboard.
WEB_BOT_USERNAME=
# Session-cookie signing key; falls back to WEBHOOK_SECRET if empty.
WEB_SESSION_SECRET=
# LOCAL ONLY: set to 1 to enable /dev-login (sign in without a domain). Never in prod.
WEB_DEV_LOGIN=0

# --- nginx reverse proxy (compose `nginx` service, ports 80/443) ---
# Hostnames the proxy routes: webhook → bot:8000, dashboard → dashboard:8080.
# For local testing the self-signed cert uses CN=localhost; point real DNS here
# (and drop real certs into the nginx_certs volume) for production.
WEBHOOK_DOMAIN=bot.localhost
DASHBOARD_DOMAIN=panel.localhost
